<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>IdentityNexus</RootNamespace>
		<Description>A Blazor UI for administering ASP.NET Core Identity users and roles.</Description>
		<Version>1.1.1</Version>
		<Authors>Matt Gordon</Authors>
		<Company>Matt Gordon</Company>
		<PackageTags>aspnetcore;identity;aspnetcore-identity;blazor;admin;user-management;role-management;ui</PackageTags>
		<PackageProjectUrl>https://github.com/gordon-matt/IdentityNexus</PackageProjectUrl>
		<RepositoryUrl>https://github.com/gordon-matt/IdentityNexus</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\_Misc\Icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\IdentityNexus.Services\IdentityNexus.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Heroicsoft.NetForge.Components" Version="1.2.3" />
	</ItemGroup>

	<ItemGroup>
		<!--
		  Served by IdentityNexus's own endpoint, so the UI works whether or not the host
		  calls UseStaticFiles or MapStaticAssets.
		-->
		<EmbeddedResource Include="Assets\*" LogicalName="IdentityNexus.Assets.%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\IdentityNexus.props" Pack="true" PackagePath="build;buildTransitive" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="IdentityNexus.Tests" />
	</ItemGroup>
</Project>