@page "/users"
@using Microsoft.AspNetCore.WebUtilities
@inject IUserService UserService
@inject IRoleService RoleService
@inject NavigationManager Navigation
@inject IOptions<IdentityNexusOptions> Options

<PageTitle>Users</PageTitle>

<div class="nx-page">
    <header class="nx-page-header">
        <div>
            <h1>Users</h1>
            <p class="nf-muted">@total.ToString("N0") @(total == 1 ? "account" : "accounts")</p>
        </div>
        <button type="button" class="nf-button nf-button-primary" @onclick="() => OpenAsync(null)">
            <Icon Name="plus" />
            New user
        </button>
    </header>

    <div class="nx-toolbar">
        <label class="nf-search">
            <Icon Name="search" />
            <input type="search" placeholder="Search name, email or phone" @bind="search" @bind:event="oninput" @bind:after="QueueSearch" />
        </label>
        <select class="nf-select" @bind="role" @bind:after="ReloadFirstPage">
            <option value="">All roles</option>
            @foreach (var item in roleOptions)
            {
                <option value="@item.Name">@item.Name</option>
            }
        </select>
        <label class="nx-check">
            <input type="checkbox" @bind="lockedOnly" @bind:after="ReloadFirstPage" />
            Locked out
        </label>
        <label class="nx-check">
            <input type="checkbox" @bind="unconfirmedOnly" @bind:after="ReloadFirstPage" />
            Unconfirmed
        </label>
    </div>

    @if (banner.Count > 0)
    {
        <div class="nx-banner" role="alert">
            @foreach (var message in banner)
            {
                <p>@message</p>
            }
        </div>
    }

    <div class="nx-workspace">
        <div class="nx-content">
            @if (items.Count == 0 && !loading)
            {
                <div class="nx-empty">
                    <h2>No users match</h2>
                    <p class="nf-muted">Try a different search, or create the first account.</p>
                </div>
            }
            else
            {
                <div class="nx-list" role="table">
                    <div class="nx-list-head nx-users-grid" role="row">
                        <span>User</span>
                        <span>Roles</span>
                        <span>Status</span>
                    </div>
                    <div class="nx-scroll">
                        @foreach (var user in items)
                        {
                            var status = user.LockedOut ? "nx-status-locked" : user.EmailConfirmed ? "nx-status-active" : "nx-status-unconfirmed";
                            <div class="nx-row nx-users-grid @status @(selected?.Id == user.Id ? "is-selected" : null)" role="row" @onclick="() => OpenAsync(user.Id)">
                                <span class="nx-cell nx-cell-stack">
                                    <span class="nx-primary">@(user.UserName ?? user.Email)</span>
                                    <span class="nx-email">@user.Email</span>
                                </span>
                                <span class="nx-cell nx-cell-pills">
                                    @foreach (var name in user.Roles)
                                    {
                                        <span class="nf-badge nf-badge-accent">@name</span>
                                    }
                                </span>
                                <span class="nx-cell">
                                    @if (user.LockedOut)
                                    {
                                        <span class="nf-badge nf-badge-warning">Locked</span>
                                    }
                                    else if (!user.EmailConfirmed)
                                    {
                                        <span class="nf-badge nf-badge-info">Unconfirmed</span>
                                    }
                                    else
                                    {
                                        <span class="nf-badge nf-badge-success">Active</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                    <div class="nx-list-foot">
                        <button type="button" class="nf-icon-button" disabled="@(page <= 1)" aria-label="Previous page" @onclick="PreviousPage">
                            <Icon Name="chevron-left" />
                        </button>
                        <span>Page @(page) of @pageCount</span>
                        <button type="button" class="nf-icon-button" disabled="@(page >= pageCount)" aria-label="Next page" @onclick="NextPage">
                            <Icon Name="chevron-right" />
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (editorOpen)
        {
            <UserEditor User="selected"
                        IsNew="isNew"
                        Roles="roleOptions"
                        OnClose="CloseEditor"
                        OnChanged="RefreshAsync" />
        }
    </div>
</div>

@code {
    private readonly List<UserSummary> items = [];
    private IReadOnlyList<RoleSummary> roleOptions = [];
    private List<string> banner = [];
    private UserDetail? selected;

    private string search = string.Empty;
    private string role = string.Empty;
    private bool lockedOnly;
    private bool unconfirmedOnly;
    private bool editorOpen;
    private bool isNew;
    private bool loading = true;
    private int page = 1;
    private int total;
    private int pageCount = 1;
    private CancellationTokenSource? searchDelay;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        lockedOnly = query.ContainsKey("locked");
        unconfirmedOnly = query.ContainsKey("unconfirmed");

        var roles = await RoleService.ListAsync();
        if (roles.IsSuccessStatus())
        {
            roleOptions = roles.Value.Where(item => !string.IsNullOrWhiteSpace(item.Name)).ToArray();
        }

        await LoadAsync();
    }

    private void QueueSearch()
    {
        searchDelay?.Cancel();
        searchDelay = new CancellationTokenSource();
        var token = searchDelay.Token;
        _ = DebounceAsync(token);
    }

    private async Task DebounceAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(250, token);
            page = 1;
            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task ReloadFirstPage()
    {
        page = 1;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        var result = await UserService.SearchAsync(new UserListQuery
        {
            Search = search,
            Role = role,
            LockedOutOnly = lockedOnly,
            UnconfirmedOnly = unconfirmedOnly,
            Page = page,
            PageSize = Options.Value.PageSize,
        });

        loading = false;
        if (!result.IsSuccessStatus())
        {
            banner = [.. result.GetDisplayMessages()];
            return;
        }

        banner = [];
        items.Clear();
        items.AddRange(result.Value.Items);
        total = result.Value.TotalCount;
        page = result.Value.Page;
        pageCount = Math.Max(1, (int)Math.Ceiling(total / (double)result.Value.PageSize));
    }

    private async Task OpenAsync(string? id)
    {
        banner = [];
        if (id is null)
        {
            isNew = true;
            selected = null;
            editorOpen = true;
            return;
        }

        var result = await UserService.GetAsync(id);
        if (!result.IsSuccessStatus())
        {
            banner = [.. result.GetDisplayMessages()];
            return;
        }

        isNew = false;
        selected = result.Value;
        editorOpen = true;
    }

    private void CloseEditor()
    {
        editorOpen = false;
        isNew = false;
    }

    private async Task RefreshAsync(string? id)
    {
        var roles = await RoleService.ListAsync();
        if (roles.IsSuccessStatus())
        {
            roleOptions = roles.Value.Where(item => !string.IsNullOrWhiteSpace(item.Name)).ToArray();
        }

        await LoadAsync();
        if (!string.IsNullOrWhiteSpace(id))
        {
            await OpenAsync(id);
        }
        else
        {
            CloseEditor();
        }
    }

    private async Task PreviousPage()
    {
        if (page > 1)
        {
            page--;
            await LoadAsync();
        }
    }

    private async Task NextPage()
    {
        if (page < pageCount)
        {
            page++;
            await LoadAsync();
        }
    }
}
