@using IdentityNexus.Extensibility
@using IdentityNexus.Services.Extensibility
@inject IRoleService Roles
@inject IOptions<IdentityNexusOptions> NexusOptions

<aside class="nx-details">
    <header class="nx-details-header">
        <div>
            <h2>@(IsNew ? "New role" : name)</h2>
        </div>
        <button type="button" class="nf-icon-button" aria-label="Close" @onclick="OnClose">
            <Icon Name="x" />
        </button>
    </header>

    @if (Sections.Count > 0)
    {
        <div class="nx-tabs" role="tablist">
            <button type="button" class="nx-tab @(tab == 0 ? "is-active" : null)" @onclick="() => tab = 0">Details</button>
            @for (int index = 0; index < Sections.Count; index++)
            {
                int sectionTab = index + 1;
                <button type="button" class="nx-tab @(tab == sectionTab ? "is-active" : null)" @onclick="() => tab = sectionTab">@Sections[index].Title</button>
            }
        </div>
    }

    @if (messages.Count > 0)
    {
        <div class="nx-banner @(saved ? "nx-banner-ok" : null)" role="status">
            @foreach (var message in messages)
            {
                <p>@message</p>
            }
        </div>
    }

    <div class="nx-form" hidden="@(tab != 0)">
        <label class="nx-field">
            <span>Name</span>
            <input class="nf-input" @bind="name" />
        </label>

        <h3>Claims</h3>
        @if (claims.Count == 0)
        {
            <p class="nf-muted">No claims on this role.</p>
        }
        else
        {
            <ul class="nx-claim-list">
                @foreach (var claim in claims)
                {
                    <li>
                        <span>
                            <strong>@ClaimTypeCatalog.DisplayName(claim.Type)</strong>
                            <span class="nf-muted nf-small">@claim.Value</span>
                        </span>
                        <button type="button" class="nf-icon-button" aria-label="Remove claim" @onclick="() => claims.Remove(claim)">
                            <Icon Name="x" />
                        </button>
                    </li>
                }
            </ul>
        }

        <label class="nx-field">
            <span>Type</span>
            <select class="nf-input" @bind="claimTypeChoice">
                <option value="">Choose a type</option>
                @foreach (var option in ClaimTypeCatalog.All)
                {
                    <option value="@option.Type">@option.Name</option>
                }
                <option value="custom">Custom</option>
            </select>
        </label>
        @if (claimTypeChoice == "custom")
        {
            <label class="nx-field">
                <span>Custom type</span>
                <input class="nf-input" @bind="customClaimType" />
            </label>
        }
        <label class="nx-field">
            <span>Value</span>
            <input class="nf-input" @bind="claimValue" />
        </label>
        <button type="button" class="nf-button" @onclick="AddClaim">Add claim</button>
    </div>

    @if (Sections.Count > 0)
    {
        <SectionPanels @ref="sectionPanels"
                       Sections="Sections"
                       Subject="subject"
                       Active="@(tab > 0 ? tab - 1 : null)" />
    }

    <footer class="nx-details-footer">
        @if (!IsNew)
        {
            <button type="button" class="nf-button nf-button-danger" disabled="@busy" @onclick="DeleteAsync">Delete</button>
        }
        <button type="button" class="nf-button" @onclick="OnClose">Cancel</button>
        <button type="button" class="nf-button nf-button-primary" disabled="@busy" @onclick="SaveAsync">
            @(IsNew ? "Create" : "Save")
        </button>
    </footer>
</aside>

<ConfirmDialog @ref="confirm" />

@code {
    /// <summary>
    /// Gets or sets the role.
    /// </summary>
    [Parameter] public RoleSummary? Role { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether this instance is new.
    /// </summary>
    [Parameter] public bool IsNew { get; set; }

    /// <summary>
    /// Gets or sets the callback raised for the close event.
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Gets or sets the callback raised for the changed event.
    /// </summary>
    [Parameter] public EventCallback<string?> OnChanged { get; set; }

    private ConfirmDialog confirm = default!;
    private SectionPanels? sectionPanels;
    private IdentitySubject subject = new(IdentitySubjectKind.Role, null, null);
    private List<string>? carriedMessages;
    private string? loadedKey;
    private int tab;
    private bool busy;
    private bool saved;
    private string name = string.Empty;
    private List<UserClaim> claims = [];
    private List<string> messages = [];
    private string claimTypeChoice = string.Empty;
    private string customClaimType = string.Empty;
    private string claimValue = string.Empty;

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        string key = IsNew ? "new" : Role?.Id ?? string.Empty;
        if (key == loadedKey)
        {
            return;
        }

        loadedKey = key;
        tab = 0;
        // A new role's sections save after it is created, and their failures should still be shown on the saved role.
        messages = carriedMessages ?? [];
        carriedMessages = null;
        subject = new IdentitySubject(IdentitySubjectKind.Role, IsNew ? null : Role?.Id, IsNew ? null : Role?.Name);
        saved = false;
        claimTypeChoice = string.Empty;
        customClaimType = string.Empty;
        claimValue = string.Empty;
        name = IsNew ? string.Empty : Role?.Name ?? string.Empty;
        claims = IsNew || Role is null ? [] : [.. Role.Claims];
    }

    private void AddClaim()
    {
        string type = claimTypeChoice == "custom" ? customClaimType.Trim() : claimTypeChoice;
        string value = claimValue.Trim();
        if (type.Length == 0 || value.Length == 0)
        {
            saved = false;
            messages = ["Enter a claim type and a value."];
            return;
        }

        if (claims.Any(claim => claim.Type == type && claim.Value == value))
        {
            saved = false;
            messages = ["That claim is already on the role."];
            return;
        }

        claims.Add(new UserClaim(type, value));
        claimValue = string.Empty;
        messages = [];
    }

    private async Task SaveAsync()
    {
        busy = true;
        saved = false;
        var result = await Roles.SaveAsync(new SaveRoleRequest(IsNew ? null : Role?.Id, name, claims));
        if (!result.IsSuccessStatus())
        {
            busy = false;
            messages = [.. result.GetDisplayMessages()];
            return;
        }

        IReadOnlyList<string> sectionMessages = sectionPanels is null ? [] : await sectionPanels.SaveAsync(result.Value.Id);
        busy = false;
        if (IsNew)
        {
            carriedMessages = [.. sectionMessages];
        }
        else
        {
            messages = [.. sectionMessages];
        }

        await OnChanged.InvokeAsync(result.Value.Id);
    }

    private IList<EditorSection> Sections => NexusOptions.Value.RoleSections;

    private async Task DeleteAsync()
    {
        if (Role is null)
        {
            return;
        }

        if (!await confirm.ShowAsync("Delete role", $"Delete {name}? Users keep their accounts, but they lose this role.", "Delete", isDestructive: true))
        {
            return;
        }

        busy = true;
        var result = await Roles.DeleteAsync(Role.Id);
        busy = false;
        if (!result.IsSuccessStatus())
        {
            saved = false;
            messages = [.. result.GetDisplayMessages()];
            return;
        }

        await OnChanged.InvokeAsync(null);
    }
}
