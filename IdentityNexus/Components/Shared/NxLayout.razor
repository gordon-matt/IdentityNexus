@inherits LayoutComponentBase
@inject IOptions<IdentityNexusOptions> Options
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JS

<AppShell Brand="@Options.Value.Title"
          BrandHref="./"
          LogoUrl="@LogoUrl"
          MarkUrl="@MarkUrl"
          Sections="@Sections"
          ShowSearch="false"
          ShowThemePicker="true"
          ShowUserMenu="false"
          ShowVersion="false">
    <TopbarEnd>
        @if (!string.IsNullOrWhiteSpace(account))
        {
            <span class="nx-account" title="@account">@account</span>
        }
        @if (!string.IsNullOrWhiteSpace(Options.Value.HomePath))
        {
            <a class="nf-icon-button" href="@Options.Value.HomePath" title="Back to the site" data-enhance="false">
                <Icon Name="arrow-left" />
            </a>
        }
        @if (!string.IsNullOrWhiteSpace(Options.Value.LogoutPath))
        {
            <form method="post" action="@Options.Value.LogoutPath" data-enhance="false">
                <button type="submit" class="nf-icon-button" title="Sign out">
                    <Icon Name="logout" />
                </button>
            </form>
        }
    </TopbarEnd>
    <ChildContent>
        @Body
    </ChildContent>
</AppShell>

@code {
    private static readonly IReadOnlyList<ForgeNavSection> Sections =
    [
        new()
        {
            Items =
            [
                new ForgeNavItem { Title = "Overview", Href = "./", Icon = "layout", MatchAll = true },
                new ForgeNavItem { Title = "Users", Href = "users", Icon = "users" },
                new ForgeNavItem { Title = "Roles", Href = "roles", Icon = "shield" },
            ],
        },
    ];

    private string? account;

    private bool UseBuiltInLogo =>
        Branding.CustomLogoUrl(Options.Value) is null && !Branding.HasCustomTitle(Options.Value);

    private string? LogoUrl => Branding.CustomLogoUrl(Options.Value)
        ?? (UseBuiltInLogo ? EmbeddedAssets.Url("Logo.png") : null);

    private string? MarkUrl => UseBuiltInLogo ? EmbeddedAssets.Url("Icon.png") : null;

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        account = state.User.Identity?.Name;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("identityNexus.ready");
        }
    }
}
