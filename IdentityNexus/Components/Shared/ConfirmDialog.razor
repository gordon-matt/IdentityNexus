@if (isVisible)
{
    <div class="nx-modal-backdrop" @onclick="() => Close(false)"></div>
    <div class="nx-modal" role="alertdialog" aria-modal="true" aria-labelledby="nx-confirm-title">
        <h2 id="nx-confirm-title">@title</h2>
        <p>@message</p>
        <div class="nx-modal-actions">
            <button type="button" class="nx-button" @onclick="() => Close(false)">Cancel</button>
            <button type="button" class="nx-button @(isDestructive ? "nx-button-danger" : "nx-button-primary")" @onclick="() => Close(true)">
                @confirmLabel
            </button>
        </div>
    </div>
}

@code {
    private bool isVisible;
    private string title = string.Empty;
    private string message = string.Empty;
    private string confirmLabel = "OK";
    private bool isDestructive;
    private TaskCompletionSource<bool>? completion;

    public Task<bool> ShowAsync(string title, string message, string confirmLabel = "OK", bool isDestructive = false)
    {
        this.title = title;
        this.message = message;
        this.confirmLabel = confirmLabel;
        this.isDestructive = isDestructive;
        isVisible = true;
        completion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        StateHasChanged();
        return completion.Task;
    }

    private void Close(bool confirmed)
    {
        isVisible = false;
        completion?.TrySetResult(confirmed);
        completion = null;
    }
}
